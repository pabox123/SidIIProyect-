# =============================================================================
# CineConecta Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# PostgreSQL Configuration
# -----------------------------------------------------------------------------
# For local development:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cineconecta_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=cineconecta

# For cloud providers (Supabase, Neon, Aiven, etc.):
# POSTGRES_HOST=your-host.supabase.co
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your-cloud-password
# POSTGRES_DB=postgres
# POSTGRES_SSL=true

# Connection pool settings
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10

# -----------------------------------------------------------------------------
# MongoDB Configuration
# -----------------------------------------------------------------------------
# For local development:
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cineconecta

# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net
# MONGODB_DB_NAME=cineconecta

# Connection pool settings
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# JWT Secret - CHANGE THIS IN PRODUCTION! Use a strong random string:
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# JWT Expiration
JWT_EXPIRES_IN=7d

# Bcrypt rounds for password hashing (10-12 recommended)
BCRYPT_ROUNDS=10

# -----------------------------------------------------------------------------
# Optional: Logging & Monitoring
# -----------------------------------------------------------------------------
# LOG_LEVEL=debug
# ENABLE_SWAGGER=true