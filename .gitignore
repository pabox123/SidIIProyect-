# =============================================================================
# CineConecta - Root Git Ignore
# =============================================================================

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment files - NEVER commit these!
.env
.env.local
.env.*.local

# Backend
backend/node_modules/
backend/dist/
backend/build/
backend/*.tsbuildinfo
backend/coverage/
backend/.nyc_output/
backend/logs/
backend/*.log
backend/.cache/
backend/.temp/
backend/tmp/

# Frontend (Vite/React)
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/*.tsbuildinfo
frontend/coverage/
frontend/.vite/
frontend/.eslintcache

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing
coverage/
.nyc_output/

# Misc
*.pem
.cache/
.temp/
tmp/

# Database
*.sqlite
*.db
*.dump

# Docker
docker-compose.override.ymlpruebas_demo/salida/
pruebas_demo/salida/
